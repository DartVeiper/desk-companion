<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="DeskAgent"/>

  <!--
    Права администратора нужны только для чтения датчиков температуры через
    LibreHardwareMonitor. Всё остальное — нажатия, окна, звук, трек, связь с
    блоком — работает и без них.

    Поэтому asInvoker, а не requireAdministrator. Прежний вариант требовал
    прав при любом запуске, и приложение, работающее без них, не могло
    поднять агента само: запуск падал с «требуется повышение прав». Теперь
    агент стартует всегда, а права получает от того, кто его запускает.

    С правами его запускает Планировщик — задача заведена «с наивысшими
    правами», и повышение она делает без запроса. Запущенный иначе агент
    работает без температур и говорит об этом в файле состояния, а
    приложение показывает это человеку.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
