<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: окна нет вовсе, ни консольного, ни какого-то ещё.

         Раньше здесь стоял Exe, и расчёт был, что прятать консоль умеет
         Планировщик задач. Не умеет: консоль висела на экране с момента
         входа в систему. А на Windows 11 с Терминалом по умолчанию её не
         спрятать и изнутри — окно принадлежит Терминалу, а не агенту.

         Вывод теперь идёт в журнал и в файл состояния, их показывает
         приложение. Ключи разведки, windows и list-sensors, по-прежнему
         печатают в терминал, если запустить их оттуда. -->
    <OutputType>WinExe</OutputType>
    <!-- Версия Windows в цели нужна ради списка проигрываемого: он живёт
         в API самой системы, и без указания версии компилятор о нём не
         знает. Пакетов при этом не добавляется — проекция идёт с SDK. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Совместимость с более старыми Windows заявляем отдельно: цель
         говорит «знаю про API десятки», а не «требую её». -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeskAgent</AssemblyName>
    <RootNamespace>DeskAgent</RootNamespace>
    <!-- Один самодостаточный exe: ставить рантайм на игровой ПК не нужно,
         а PyInstaller-сборку Python-версии Defender считал бы кейлоггером. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Сжатие: 181 МБ превращаются в 76. Платим полусекундой на первом
         запуске, когда рантайм распаковывается во временную папку; дальше
         он оттуда и берётся. Для файла, который люди качают с гитхаба,
         размен очевидный. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Ради этой библиотеки агент и написан на C#: из Python пришлось бы
         держать запущенным само приложение LHM и парсить его веб-сервер. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.3" />
  </ItemGroup>

</Project>
