<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Exe, а не WinExe: у оконного приложения нет консоли, и весь вывод
         агента — включая предупреждение «запусти от администратора, иначе
         температуры не читаются» — уходил бы в никуда. Первый запуск всегда
         ручной и всегда из терминала. Прятать окно потом умеет Планировщик
         задач: там это галочка «Свернуть», а не свойство сборки. -->
    <OutputType>Exe</OutputType>
    <!-- Версия Windows в цели нужна ради списка проигрываемого: он живёт
         в API самой системы, и без указания версии компилятор о нём не
         знает. Пакетов при этом не добавляется — проекция идёт с SDK. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Совместимость с более старыми Windows заявляем отдельно: цель
         говорит «знаю про API десятки», а не «требую её». -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeskAgent</AssemblyName>
    <RootNamespace>DeskAgent</RootNamespace>
    <!-- Один самодостаточный exe: ставить рантайм на игровой ПК не нужно,
         а PyInstaller-сборку Python-версии Defender считал бы кейлоггером. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Сжатие: 181 МБ превращаются в 76. Платим полусекундой на первом
         запуске, когда рантайм распаковывается во временную папку; дальше
         он оттуда и берётся. Для файла, который люди качают с гитхаба,
         размен очевидный. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Ради этой библиотеки агент и написан на C#: из Python пришлось бы
         держать запущенным само приложение LHM и парсить его веб-сервер. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.3" />
  </ItemGroup>

</Project>
