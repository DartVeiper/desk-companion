# Python bytecode / caches
__pycache__/
*.py[cod]

# SQLite databases + WAL/SHM temp files
# (schema lives in pi/app/schema.sql; data is generated/seedable)
*.db
*.db-shm
*.db-wal

# Превью целиком — это свалка отрисовок и вывод бэкенда разработки.
# Всё здесь создаётся запуском рисовалок и тестов, поэтому в репозитории
# ему не место: больше половины файлов когда-то были именно этими
# картинками. Те, на которые ссылается документация, лежат в docs/.
pi/preview/
pi/.version

# Сборка приложения для ПК. Самодостаточный exe весит под 80 МБ — в
# репозитории ему не место: он полностью воспроизводится из исходников одной
# командой.
pc/**/bin/
pc/**/obj/

# Готовая программа, которую складывает pc/build.ps1. Восемьдесят мегабайт,
# и собирается она одной командой из исходников рядом.
Программа/

# Адрес блока в домашней сети — не общее знание проекта.
.deploy-target

# Результаты калибровки — свойство конкретного экземпляра, а не
# проекта: пороги тача зависят от панели, пороги радара от комнаты.
pi/app/calibration.toml
