<Window x:Class="DeskCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DeskCompanion.Services"
        Title="Desk Companion" Height="660" Width="1040"
        MinHeight="560" MinWidth="880"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Все надписи — через {l:T ключ}: текст лежит в Strings, по словарю на
         язык, и меняется на лету вместе с выбранным языком. -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================ боковое меню -->
        <Border Grid.Column="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,26,18,26">
                    <TextBlock Text="Desk Companion" Foreground="{StaticResource Fg}"
                               FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubTitle" Text="{l:T link_searching}" FontSize="11"
                               Foreground="{StaticResource Dim}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Состояние связи внизу: смотреть на него постоянно не надо,
                     но когда данные замерли — это первое, что спрашивают. -->
                <Border DockPanel.Dock="Bottom" Margin="18,0,18,18" Padding="12,10"
                        CornerRadius="8" Background="#FF11141A">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LinkDot" Width="8" Height="8"
                                     Fill="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LinkText" Text="{l:T link_none}" Margin="8,0,0,0"
                                       FontSize="12" Foreground="{StaticResource Dim}"/>
                        </StackPanel>
                        <TextBlock x:Name="LinkDetail" Text="" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{StaticResource Dim}" Margin="16,3,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavButton}"
                                 Content="{l:T nav_overview}" IsChecked="True"
                                 Checked="Nav_Checked" Tag="0"/>
                    <RadioButton x:Name="NavScreens" Style="{StaticResource NavButton}"
                                 Content="{l:T nav_screens}" Checked="Nav_Checked" Tag="1"/>
                    <RadioButton x:Name="NavStats" Style="{StaticResource NavButton}"
                                 Content="{l:T nav_stats}" Checked="Nav_Checked" Tag="2"/>
                    <RadioButton x:Name="NavRadar" Style="{StaticResource NavButton}"
                                 Content="{l:T nav_radar}" Checked="Nav_Checked" Tag="3"/>
                    <RadioButton x:Name="NavComputer" Style="{StaticResource NavButton}"
                                 Content="{l:T nav_computer}" Checked="Nav_Checked" Tag="4"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}"
                                 Content="{l:T nav_settings}" Checked="Nav_Checked" Tag="5"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================================================== страницы -->
        <Grid Grid.Column="1" Margin="28,26,28,24">

            <!-- ================================================= обзор -->
            <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{l:T nav_overview}" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="OverviewHint" Style="{StaticResource Caption}"
                               Text="{l:T overview_hint}" Margin="0,0,0,18"/>

                    <ItemsControl x:Name="ProblemList" Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FF241A1A" BorderBrush="{StaticResource Alert}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="14,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Alert}"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Foreground="{StaticResource Fg}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <UniformGrid Columns="3" Rows="1">
                        <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="{l:T card_air}" Style="{StaticResource CardTitle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Co2Value" Text="—" Style="{StaticResource Metric}"/>
                                    <TextBlock Text="ppm" Style="{StaticResource Caption}"
                                               Margin="6,0,0,6" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <TextBlock x:Name="AirCaption" Text="—" Style="{StaticResource Caption}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="7,0,7,0">
                            <StackPanel>
                                <TextBlock Text="{l:T card_desk}" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="PresenceValue" Text="—" Style="{StaticResource Metric}"/>
                                <TextBlock x:Name="PresenceCaption" Text="—"
                                           Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:T card_outside}" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="WeatherValue" Text="—" Style="{StaticResource Metric}"/>
                                <TextBlock x:Name="WeatherCaption" Text="—"
                                           Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T card_pc}" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="ActiveApp" Text="—" Style="{StaticResource Body}"
                                       FontSize="15" Margin="0,0,0,14"/>
                            <UniformGrid Columns="4" Rows="1">
                                <StackPanel>
                                    <TextBlock x:Name="CpuLoad" Text="—" Style="{StaticResource Metric}"
                                               FontSize="22"/>
                                    <TextBlock Text="{l:T pc_cpu}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="CpuTemp" Text="—" Style="{StaticResource Metric}"
                                               FontSize="22"/>
                                    <TextBlock Text="{l:T pc_cpu_temp}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="GpuLoad" Text="—" Style="{StaticResource Metric}"
                                               FontSize="22"/>
                                    <TextBlock Text="{l:T pc_gpu}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="GpuTemp" Text="—" Style="{StaticResource Metric}"
                                               FontSize="22"/>
                                    <TextBlock Text="{l:T pc_gpu_temp}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T card_board}" Style="{StaticResource CardTitle}"/>
                            <UniformGrid x:Name="BoardGrid" Columns="4" Rows="2"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================================ экраны -->
            <Grid x:Name="PageScreens" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{l:T nav_screens}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,18"
                               Text="{l:T screens_hint}"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                    <ListBox x:Name="ScreenList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="ScreenList_MouseDown"
                             PreviewMouseMove="ScreenList_MouseMove"
                             PreviewMouseLeftButtonUp="ScreenList_MouseUp"
                             LostMouseCapture="ScreenList_LostCapture">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Background="Transparent"
                                                    CornerRadius="7" Margin="0,2" Padding="10,9">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background"
                                                            Value="#FF1E232C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⋮⋮" FontSize="13"
                                               Foreground="{StaticResource Dim}"
                                               VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding On}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Label}"
                                               Foreground="{StaticResource Fg}" FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Position}"
                                               Foreground="{StaticResource Dim}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="SaveScreens" Content="{l:T screens_apply}"
                            Style="{StaticResource Flat}" Click="SaveScreens_Click"/>
                    <Button x:Name="ReloadScreens" Content="{l:T screens_reload}"
                            Style="{StaticResource Flat}" Margin="10,0,0,0"
                            Click="ReloadScreens_Click"/>
                    <TextBlock x:Name="ScreensNote" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ============================================ статистика -->
            <ScrollViewer x:Name="PageStats" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{l:T nav_stats}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,18"
                               Text="{l:T stats_hint}"/>

                    <UniformGrid Columns="4" Rows="1">
                        <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="{l:T stats_at_desk}" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="AtDesk" Text="—" Style="{StaticResource Metric}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="7,0,7,0">
                            <StackPanel>
                                <TextBlock Text="{l:T stats_longest}" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="Longest" Text="—" Style="{StaticResource Metric}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="7,0,7,0">
                            <StackPanel>
                                <TextBlock Text="{l:T stats_keys}" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="Keys" Text="—" Style="{StaticResource Metric}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:T stats_clicks}" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="Clicks" Text="—" Style="{StaticResource Metric}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T stats_by_hour}" Style="{StaticResource CardTitle}"/>
                            <ItemsControl x:Name="HourBars" Height="120">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="24"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,0">
                                            <Rectangle VerticalAlignment="Bottom"
                                                       Height="{Binding Height}"
                                                       RadiusX="3" RadiusY="3"
                                                       Fill="{StaticResource Accent}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <UniformGrid Rows="1" Columns="24" Margin="0,6,0,0">
                                <TextBlock Text="0" Style="{StaticResource Caption}" FontSize="9"/>
                                <TextBlock/><TextBlock/>
                                <TextBlock Text="3" Style="{StaticResource Caption}" FontSize="9"/>
                                <TextBlock/><TextBlock/>
                                <TextBlock Text="6" Style="{StaticResource Caption}" FontSize="9"/>
                                <TextBlock/><TextBlock/>
                                <TextBlock Text="9" Style="{StaticResource Caption}" FontSize="9"/>
                                <TextBlock/><TextBlock/>
                                <TextBlock Text="12" Style="{StaticResource Caption}" FontSize="9"/>
                                <TextBlock/><TextBlock/>
                                <TextBlock Text="15" Style="{StaticResource Caption}" FontSize="9"/>
                                <TextBlock/><TextBlock/>
                                <TextBlock Text="18" Style="{StaticResource Caption}" FontSize="9"/>
                                <TextBlock/><TextBlock/>
                                <TextBlock Text="21" Style="{StaticResource Caption}" FontSize="9"/>
                                <TextBlock/><TextBlock/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T stats_by_category}" Style="{StaticResource CardTitle}"/>
                            <ItemsControl x:Name="CategoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       Style="{StaticResource Body}"/>
                                            <Border Grid.Column="1" Height="8" CornerRadius="4"
                                                    Background="#FF20242C"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center">
                                                <Border Background="{StaticResource Accent}"
                                                        CornerRadius="4"
                                                        HorizontalAlignment="Left"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Value}"
                                                       Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================================= радар -->
            <!-- Что видит радар и почему блок решил так, а не иначе. Без этой
                 страницы вопрос «почему часы считают, что я за столом, когда
                 меня нет» решался только чтением журнала на самом блоке. -->
            <ScrollViewer x:Name="PageRadar" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{l:T nav_radar}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,18"
                               Text="{l:T radar_hint}"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T radar_verdict_title}" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="RadarDot" Width="10" Height="10"
                                         Fill="{StaticResource Dim}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RadarVerdict" Text="—" Margin="10,0,0,0"
                                           Style="{StaticResource Metric}" FontSize="22"/>
                            </StackPanel>
                            <TextBlock x:Name="RadarReason" Style="{StaticResource Body}"
                                       Margin="20,6,0,0" TextWrapping="Wrap"/>
                            <UniformGrid x:Name="RadarFacts" Columns="3" Rows="1" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T radar_zones_title}" Style="{StaticResource CardTitle}"/>
                            <WrapPanel Margin="0,0,0,10">
                                <Border Width="10" Height="10" CornerRadius="2"
                                        Background="{StaticResource Accent}" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:T radar_legend_moving}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="6,0,18,0"/>
                                <Border Width="10" Height="10" CornerRadius="2"
                                        Background="{StaticResource Still}" VerticalAlignment="Center"/>
                                <TextBlock Text="{l:T radar_legend_static}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="6,0,18,0"/>
                                <Rectangle Width="2" Height="12" Fill="{StaticResource Fg}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{l:T radar_legend_threshold}" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </WrapPanel>
                            <ItemsControl x:Name="ZoneList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3" Opacity="{Binding Opacity}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontSize="13"
                                                           Foreground="{StaticResource Fg}"/>
                                                <TextBlock Text="{Binding Role}" FontSize="10"
                                                           Foreground="{Binding RoleBrush}"/>
                                            </StackPanel>
                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="14"/>
                                                    <RowDefinition Height="14"/>
                                                </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Height="6" CornerRadius="3"
                                                    Background="{StaticResource Track}"/>
                                            <Grid Grid.Row="0" Height="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Moving.Fill}"/>
                                                    <ColumnDefinition Width="{Binding Moving.Rest}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="3" Background="{Binding Moving.Brush}"/>
                                            </Grid>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Moving.Mark}"/>
                                                    <ColumnDefinition Width="{Binding Moving.MarkRest}"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="1" Width="2" Margin="-1,1,0,1"
                                                           HorizontalAlignment="Left"
                                                           Fill="{StaticResource Fg}"
                                                           Visibility="{Binding Moving.MarkShown}"/>
                                            </Grid>
                                            <Border Grid.Row="1" Height="6" CornerRadius="3"
                                                    Background="{StaticResource Track}"/>
                                            <Grid Grid.Row="1" Height="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Static.Fill}"/>
                                                    <ColumnDefinition Width="{Binding Static.Rest}"/>
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="3" Background="{Binding Static.Brush}"/>
                                            </Grid>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding Static.Mark}"/>
                                                    <ColumnDefinition Width="{Binding Static.MarkRest}"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Column="1" Width="2" Margin="-1,1,0,1"
                                                           HorizontalAlignment="Left"
                                                           Fill="{StaticResource Fg}"
                                                           Visibility="{Binding Static.MarkShown}"/>
                                            </Grid>
                                            </Grid>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Moving.Text}" Height="14"
                                                           FontSize="10" TextAlignment="Right"
                                                           Foreground="{StaticResource Dim}"/>
                                                <TextBlock Text="{Binding Static.Text}" Height="14"
                                                           FontSize="10" TextAlignment="Right"
                                                           Foreground="{StaticResource Dim}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T radar_how_title}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap"
                                       Text="{l:T radar_how_1}"/>
                            <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap"
                                       Margin="0,8,0,0" Text="{l:T radar_how_2}"/>
                            <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap"
                                       Margin="0,8,0,0" Text="{l:T radar_how_3}"/>
                            <TextBlock x:Name="RadarLevels" Style="{StaticResource Caption}"
                                       Margin="0,10,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================================== компьютер -->
            <!-- Сбор данных с этого компьютера. Раньше им занималась отдельная
                 программа — агент; теперь он часть приложения, и всё, что агент
                 печатал в свою консоль, показывается здесь. -->
            <ScrollViewer x:Name="PageComputer" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{l:T nav_computer}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,18"
                               Text="{l:T computer_hint}"/>

                    <Border x:Name="OldAgentCard" Visibility="Collapsed"
                            Background="#FF241A1A" BorderBrush="{StaticResource Alert}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{l:T computer_old_agent}" TextWrapping="Wrap"
                                       FontSize="12" Foreground="{StaticResource Fg}"/>
                            <Button x:Name="OldAgentFix" Content="{l:T computer_old_agent_fix}"
                                    Style="{StaticResource Flat}" HorizontalAlignment="Left"
                                    Margin="0,10,0,0" Click="Grant_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T computer_state_title}" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ComputerDot" Width="10" Height="10"
                                         Fill="{StaticResource Dim}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ComputerStatus" Text="—" Margin="10,0,0,0"
                                           Style="{StaticResource Metric}" FontSize="22"/>
                            </StackPanel>
                            <TextBlock x:Name="ComputerError" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource Alert}" TextWrapping="Wrap"
                                       Margin="20,4,0,0" Visibility="Collapsed"/>

                            <UniformGrid x:Name="ComputerFacts" Columns="3" Rows="2" Margin="0,16,0,0"/>

                            <Border x:Name="TempsHint" Visibility="Collapsed"
                                    Background="#FF2A2416" BorderBrush="{StaticResource Warn}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10"
                                    Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="{l:T computer_temps_hint}" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{StaticResource Fg}"/>
                                    <Button x:Name="GrantRights" Content="{l:T computer_grant}"
                                            Style="{StaticResource Flat}" HorizontalAlignment="Left"
                                            Margin="0,10,0,0" Click="Grant_Click"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="GrantState" Style="{StaticResource Caption}"
                                       TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

                            <CheckBox x:Name="CollectBox" Content="{l:T computer_enabled}" FontSize="13"
                                      Margin="0,16,0,0" Click="Collect_Click"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Text="{l:T computer_enabled_note}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T computer_log_title}" Style="{StaticResource CardTitle}"/>
                            <TextBox x:Name="ComputerLogBox" Style="{StaticResource Console}" Height="190"/>
                            <Button Content="{l:T computer_log_open}" Style="{StaticResource Flat}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Click="ComputerLogOpen_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T computer_probe_title}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="{l:T computer_probe_note}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="ProbeWindows" Content="{l:T computer_probe_windows}"
                                        Style="{StaticResource Flat}" Click="ProbeWindows_Click"/>
                                <Button x:Name="ProbeSensors" Content="{l:T computer_probe_sensors}"
                                        Style="{StaticResource Flat}" Margin="10,0,0,0"
                                        Click="ProbeSensors_Click"/>
                            </StackPanel>
                            <TextBox x:Name="ProbeOutput" Style="{StaticResource Console}"
                                     Height="190" Margin="0,12,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================================= настройки -->
            <ScrollViewer x:Name="PageSettings" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{l:T nav_settings}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,18"
                               Text="{l:T settings_hint}"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T host_title}" Style="{StaticResource CardTitle}"/>
                            <WrapPanel>
                                <TextBox x:Name="HostBox" Width="220" FontSize="13" Margin="0,0,8,6"/>
                                <TextBox x:Name="PortBox" Width="70" FontSize="13" Margin="0,0,10,6"/>
                                <Button Content="{l:T host_test}"
                                        Style="{StaticResource Flat}" Margin="0,0,0,6"
                                        Click="TestHost_Click"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" Text="{l:T host_note}"/>
                            <TextBlock x:Name="TestResult" Style="{StaticResource Caption}"
                                       Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T lang_title}" Style="{StaticResource CardTitle}"/>
                            <ComboBox x:Name="LangBox" Width="220" HorizontalAlignment="Left"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="LangBox_Changed"/>
                            <TextBlock x:Name="LangState" Style="{StaticResource Body}"
                                       Margin="0,10,0,0"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       TextWrapping="Wrap" Text="{l:T lang_note}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T city_title}" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="CityNow" Style="{StaticResource Body}"
                                       Margin="0,2,0,0" Text="{l:T link_waiting}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBox x:Name="CityBox" Width="300" FontSize="13"
                                         KeyDown="CityBox_KeyDown"/>
                                <Button Content="{l:T city_find}" Style="{StaticResource Flat}"
                                        Margin="10,0,0,0" Click="CityFind_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="CityNote" Style="{StaticResource Caption}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="{l:T city_note}"/>
                            <ListBox x:Name="CityList" Background="Transparent" BorderThickness="0"
                                     MaxHeight="190" Margin="0,8,0,0" Visibility="Collapsed"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="CityPick_Click">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Row" Background="Transparent"
                                                            CornerRadius="6" Margin="0,1" Padding="9,7">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="#FF1E232C"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="#FF232A35"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       Foreground="{StaticResource Fg}"/>
                                            <TextBlock Text="{Binding Where}" FontSize="11"
                                                       Foreground="{StaticResource Dim}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button x:Name="CityApply" Content="{l:T city_apply}"
                                    Style="{StaticResource Flat}" HorizontalAlignment="Left"
                                    Margin="0,10,0,0" IsEnabled="False" Click="CityPick_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T touch_title}" Style="{StaticResource CardTitle}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{l:T touch_hard}" VerticalAlignment="Center"
                                           Style="{StaticResource Caption}" Margin="0,0,12,0"/>
                                <Slider x:Name="TouchSlider" Grid.Column="1"
                                        Minimum="2000" Maximum="15000"
                                        TickFrequency="500" IsSnapToTickEnabled="True"
                                        IsEnabled="False"
                                        Thumb.DragCompleted="TouchSlider_Done"
                                        ValueChanged="TouchSlider_Changed"/>
                                <TextBlock Grid.Column="2" Text="{l:T touch_easy}" VerticalAlignment="Center"
                                           Style="{StaticResource Caption}" Margin="12,0,0,0"/>
                            </Grid>
                            <TextBlock x:Name="TouchState" Style="{StaticResource Body}"
                                       Margin="0,10,0,0" Text="{l:T link_waiting}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       TextWrapping="Wrap" Text="{l:T touch_note}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Text="{l:T touch_note_safe}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T calib_title}" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="{l:T calib_note}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="CalibStart" Content="{l:T calib_start}"
                                        Style="{StaticResource Flat}" Click="CalibStart_Click"/>
                                <Button x:Name="CalibCancel" Content="{l:T calib_cancel}"
                                        Style="{StaticResource Flat}" Margin="10,0,0,0"
                                        Visibility="Collapsed" Click="CalibCancel_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="CalibState" Style="{StaticResource Body}"
                                       Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T startup_title}" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="AutostartBox" FontSize="13"
                                      Content="{l:T startup_autostart}" Click="Autostart_Click"/>
                            <TextBlock x:Name="AutostartState" Style="{StaticResource Caption}"
                                       Margin="26,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                            <CheckBox x:Name="MinimizedBox" FontSize="13" Margin="0,10,0,0"
                                      Content="{l:T startup_minimized}" Click="Minimized_Click"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                       TextWrapping="Wrap" Text="{l:T startup_note}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T backup_title}" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="BackupState" Style="{StaticResource Body}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="BackupNow" Content="{l:T backup_now}"
                                        Style="{StaticResource Flat}" Click="BackupNow_Click"/>
                                <Button Content="{l:T backup_open}" Style="{StaticResource Flat}"
                                        Margin="10,0,0,0" Click="OpenBackups_Click"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                                       TextWrapping="Wrap" Text="{l:T backup_note}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
