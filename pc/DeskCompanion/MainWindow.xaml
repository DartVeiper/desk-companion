<Window x:Class="DeskCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desk Companion" Height="660" Width="1040"
        MinHeight="560" MinWidth="880"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================================ боковое меню -->
        <Border Grid.Column="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,26,18,26">
                    <TextBlock Text="Desk Companion" Foreground="{StaticResource Fg}"
                               FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubTitle" Text="ищу плату" FontSize="11"
                               Foreground="{StaticResource Dim}" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Состояние связи внизу: смотреть на него постоянно не надо,
                     но когда данные замерли — это первое, что спрашивают. -->
                <Border DockPanel.Dock="Bottom" Margin="18,0,18,18" Padding="12,10"
                        CornerRadius="8" Background="#FF11141A">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LinkDot" Width="8" Height="8"
                                     Fill="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LinkText" Text="нет связи" Margin="8,0,0,0"
                                       FontSize="12" Foreground="{StaticResource Dim}"/>
                        </StackPanel>
                        <TextBlock x:Name="LinkDetail" Text="" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{StaticResource Dim}" Margin="16,3,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <RadioButton x:Name="NavOverview" Style="{StaticResource NavButton}"
                                 Content="Обзор" IsChecked="True" Checked="Nav_Checked" Tag="0"/>
                    <RadioButton x:Name="NavScreens" Style="{StaticResource NavButton}"
                                 Content="Экраны" Checked="Nav_Checked" Tag="1"/>
                    <RadioButton x:Name="NavStats" Style="{StaticResource NavButton}"
                                 Content="Статистика" Checked="Nav_Checked" Tag="2"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}"
                                 Content="Настройки" Checked="Nav_Checked" Tag="3"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================================================== страницы -->
        <Grid Grid.Column="1" Margin="28,26,28,24">

            <!-- ================================================= обзор -->
            <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Обзор" Style="{StaticResource PageTitle}"/>
                    <TextBlock x:Name="OverviewHint" Style="{StaticResource Caption}"
                               Text="всё, что блок знает прямо сейчас" Margin="0,0,0,18"/>

                    <ItemsControl x:Name="ProblemList" Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FF241A1A" BorderBrush="{StaticResource Alert}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="14,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Alert}"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Foreground="{StaticResource Fg}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <UniformGrid Columns="3" Rows="1">
                        <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="ВОЗДУХ" Style="{StaticResource CardTitle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Co2Value" Text="—" Style="{StaticResource Metric}"/>
                                    <TextBlock Text="ppm" Style="{StaticResource Caption}"
                                               Margin="6,0,0,6" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <TextBlock x:Name="AirCaption" Text="—" Style="{StaticResource Caption}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="7,0,7,0">
                            <StackPanel>
                                <TextBlock Text="СТОЛ" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="PresenceValue" Text="—" Style="{StaticResource Metric}"/>
                                <TextBlock x:Name="PresenceCaption" Text="—"
                                           Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="ЗА ОКНОМ" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="WeatherValue" Text="—" Style="{StaticResource Metric}"/>
                                <TextBlock x:Name="WeatherCaption" Text="—"
                                           Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="КОМПЬЮТЕР" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="ActiveApp" Text="—" Style="{StaticResource Body}"
                                       FontSize="15" Margin="0,0,0,14"/>
                            <UniformGrid Columns="4" Rows="1">
                                <StackPanel>
                                    <TextBlock x:Name="CpuLoad" Text="—" Style="{StaticResource Metric}"
                                               FontSize="22"/>
                                    <TextBlock Text="процессор" Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="CpuTemp" Text="—" Style="{StaticResource Metric}"
                                               FontSize="22"/>
                                    <TextBlock Text="его температура" Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="GpuLoad" Text="—" Style="{StaticResource Metric}"
                                               FontSize="22"/>
                                    <TextBlock Text="видеокарта" Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="GpuTemp" Text="—" Style="{StaticResource Metric}"
                                               FontSize="22"/>
                                    <TextBlock Text="её температура" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="БЛОК" Style="{StaticResource CardTitle}"/>
                            <UniformGrid x:Name="BoardGrid" Columns="4" Rows="2"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ================================================ экраны -->
            <Grid x:Name="PageScreens" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Экраны" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,18"
                               Text="галочка включает экран, перетаскивание строки меняет порядок в карусели"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
                    <ListBox x:Name="ScreenList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonDown="ScreenList_MouseDown"
                             PreviewMouseMove="ScreenList_MouseMove"
                             PreviewMouseLeftButtonUp="ScreenList_MouseUp"
                             LostMouseCapture="ScreenList_LostCapture">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Background="Transparent"
                                                    CornerRadius="7" Margin="0,2" Padding="10,9">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background"
                                                            Value="#FF1E232C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⋮⋮" FontSize="13"
                                               Foreground="{StaticResource Dim}"
                                               VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding On}"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Label}"
                                               Foreground="{StaticResource Fg}" FontSize="13"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Position}"
                                               Foreground="{StaticResource Dim}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="SaveScreens" Content="Применить на блоке"
                            Style="{StaticResource Flat}" Click="SaveScreens_Click"/>
                    <Button x:Name="ReloadScreens" Content="Обновить"
                            Style="{StaticResource Flat}" Margin="10,0,0,0"
                            Click="ReloadScreens_Click"/>
                    <TextBlock x:Name="ScreensNote" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ============================================ статистика -->
            <ScrollViewer x:Name="PageStats" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Статистика" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,18"
                               Text="за сегодня, по данным блока"/>

                    <UniformGrid Columns="4" Rows="1">
                        <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                            <StackPanel>
                                <TextBlock Text="ЗА СТОЛОМ" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="AtDesk" Text="—" Style="{StaticResource Metric}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="7,0,7,0">
                            <StackPanel>
                                <TextBlock Text="БЕЗ ПЕРЕРЫВА" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="Longest" Text="—" Style="{StaticResource Metric}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="7,0,7,0">
                            <StackPanel>
                                <TextBlock Text="НАЖАТИЙ" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="Keys" Text="—" Style="{StaticResource Metric}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="7,0,0,0">
                            <StackPanel>
                                <TextBlock Text="КЛИКОВ" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="Clicks" Text="—" Style="{StaticResource Metric}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="ПО ЧАСАМ" Style="{StaticResource CardTitle}"/>
                            <ItemsControl x:Name="HourBars" Height="120">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="24"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,0">
                                            <Rectangle VerticalAlignment="Bottom"
                                                       Height="{Binding Height}"
                                                       RadiusX="3" RadiusY="3"
                                                       Fill="{StaticResource Accent}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <UniformGrid Rows="1" Columns="24" Margin="0,6,0,0">
                                <TextBlock Text="0" Style="{StaticResource Caption}" FontSize="9"/>
                                <TextBlock/><TextBlock/>
                                <TextBlock Text="3" Style="{StaticResource Caption}" FontSize="9"/>
                                <TextBlock/><TextBlock/>
                                <TextBlock Text="6" Style="{StaticResource Caption}" FontSize="9"/>
                                <TextBlock/><TextBlock/>
                                <TextBlock Text="9" Style="{StaticResource Caption}" FontSize="9"/>
                                <TextBlock/><TextBlock/>
                                <TextBlock Text="12" Style="{StaticResource Caption}" FontSize="9"/>
                                <TextBlock/><TextBlock/>
                                <TextBlock Text="15" Style="{StaticResource Caption}" FontSize="9"/>
                                <TextBlock/><TextBlock/>
                                <TextBlock Text="18" Style="{StaticResource Caption}" FontSize="9"/>
                                <TextBlock/><TextBlock/>
                                <TextBlock Text="21" Style="{StaticResource Caption}" FontSize="9"/>
                                <TextBlock/><TextBlock/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="ЧЕМ ЗАНЯТ" Style="{StaticResource CardTitle}"/>
                            <ItemsControl x:Name="CategoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       Style="{StaticResource Body}"/>
                                            <Border Grid.Column="1" Height="8" CornerRadius="4"
                                                    Background="#FF20242C"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center">
                                                <Border Background="{StaticResource Accent}"
                                                        CornerRadius="4"
                                                        HorizontalAlignment="Left"
                                                        Width="{Binding BarWidth}"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Value}"
                                                       Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================================= настройки -->
            <ScrollViewer x:Name="PageSettings" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,18"
                               Text="настройки самого приложения; всё про экраны живёт на блоке"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ГДЕ ИСКАТЬ БЛОК" Style="{StaticResource CardTitle}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="HostBox" Width="260" FontSize="13"/>
                                <TextBox x:Name="PortBox" Width="80" Margin="8,0,0,0" FontSize="13"/>
                                <Button Content="Проверить" Style="{StaticResource Flat}"
                                        Margin="10,0,0,0" Click="TestHost_Click"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="Имя deskpi.local из Windows находится через раз — если связи нет, впиши адрес цифрами, его видно в веб-интерфейсе роутера."/>
                            <TextBlock x:Name="TestResult" Style="{StaticResource Caption}"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="ГОРОД ДЛЯ ПОГОДЫ" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="CityNow" Style="{StaticResource Body}"
                                       Margin="0,2,0,0" Text="жду блок"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBox x:Name="CityBox" Width="300" FontSize="13"
                                         KeyDown="CityBox_KeyDown"/>
                                <Button Content="Найти" Style="{StaticResource Flat}"
                                        Margin="10,0,0,0" Click="CityFind_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="CityNote" Style="{StaticResource Caption}"
                                       Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Впиши название и нажми «Найти» — ищется по всем населённым пунктам мира, не по списку крупных городов."/>
                            <ListBox x:Name="CityList" Background="Transparent" BorderThickness="0"
                                     MaxHeight="190" Margin="0,8,0,0" Visibility="Collapsed"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="CityPick_Click">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Row" Background="Transparent"
                                                            CornerRadius="6" Margin="0,1" Padding="9,7">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="#FF1E232C"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Row" Property="Background" Value="#FF232A35"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       Foreground="{StaticResource Fg}"/>
                                            <TextBlock Text="{Binding Where}" FontSize="11"
                                                       Foreground="{StaticResource Dim}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button x:Name="CityApply" Content="Поставить на блок"
                                    Style="{StaticResource Flat}" HorizontalAlignment="Left"
                                    Margin="0,10,0,0" IsEnabled="False" Click="CityPick_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="ЧУВСТВИТЕЛЬНОСТЬ ЭКРАНА" Style="{StaticResource CardTitle}"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="туго" VerticalAlignment="Center"
                                           Style="{StaticResource Caption}" Margin="0,0,12,0"/>
                                <Slider x:Name="TouchSlider" Grid.Column="1"
                                        Minimum="2000" Maximum="15000"
                                        TickFrequency="500" IsSnapToTickEnabled="True"
                                        IsEnabled="False"
                                        Thumb.DragCompleted="TouchSlider_Done"
                                        ValueChanged="TouchSlider_Changed"/>
                                <TextBlock Grid.Column="2" Text="легко" VerticalAlignment="Center"
                                           Style="{StaticResource Caption}" Margin="12,0,0,0"/>
                            </Grid>
                            <TextBlock x:Name="TouchState" Style="{StaticResource Body}"
                                       Margin="0,10,0,0" Text="жду блок"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Text="Экран блока резистивный: он меряет не касание, а насколько сильно прижались друг к другу два слоя. Ползунок задаёт, с какого прижатия считать это нажатием — вправо значит легче. Действует сразу, перезагружать блок не нужно."/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Text="Поднимать почти безопасно: у нетронутой панели ложных нажатий не возникает ни при каком пороге. Если всё же начало нажиматься само — ведите влево."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="ЗАПУСК" Style="{StaticResource CardTitle}"/>
                            <CheckBox x:Name="AutostartBox" Foreground="{StaticResource Fg}"
                                      FontSize="13" Content="Запускать вместе с Windows"
                                      Click="Autostart_Click"/>
                            <CheckBox x:Name="MinimizedBox" Foreground="{StaticResource Fg}"
                                      FontSize="13" Margin="0,10,0,0"
                                      Content="Стартовать свёрнутым в трей"
                                      Click="Minimized_Click"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="Приложение ждёт блок само: пока его нет в сети, оно тихо висит в трее и подключается, как только тот появится."/>
                            <TextBlock x:Name="AgentAutostart" Style="{StaticResource Body}"
                                       Margin="0,14,0,0"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Text="Агент поднимается задачей планировщика, а не обычным автозапуском: ему нужны права администратора, иначе не читаются температуры. Завести или снять — pc\autostart.ps1 от имени администратора."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="КОПИИ БАЗЫ" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="BackupState" Style="{StaticResource Body}"
                                       Text="копий ещё нет"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="BackupNow" Content="Снять копию сейчас"
                                        Style="{StaticResource Flat}" Click="BackupNow_Click"/>
                                <Button Content="Открыть папку" Style="{StaticResource Flat}"
                                        Margin="10,0,0,0" Click="OpenBackups_Click"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                                       TextWrapping="Wrap"
                                       Text="История измерений живёт на карте памяти блока в единственном экземпляре, а карта — расходник. Приложение забирает базу раз в сутки и хранит последние семь копий."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="АГЕНТ" Style="{StaticResource CardTitle}"/>
                            <TextBlock x:Name="AgentState" Style="{StaticResource Body}"/>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Text="Агент — отдельная программа, она снимает с компьютера нажатия, загрузку и температуры и отдаёт их блоку. Здесь видно, доходят ли его данные."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
