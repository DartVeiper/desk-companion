<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Версия Windows в цели нужна ради списка проигрываемого: он живёт
         в API самой системы, и без указания версии компилятор о нём не
         знает. Совместимость со старыми Windows заявлена отдельно: цель
         говорит «знаю про API десятки», а не «требую её». -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeskCompanion</AssemblyName>
    <RootNamespace>DeskCompanion</RootNamespace>
    <ApplicationIcon></ApplicationIcon>
    <!-- Один файл при публикации: ставить приложение из десятка dll неудобно,
         а самораспаковка стоит полсекунды при первом запуске. -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Самодостаточно: рантайм внутри exe.

         Раньше здесь стояло false, и на машине разработчика это незаметно —
         .NET там уже есть вместе с SDK. Скачавший же релиз получал вместо
         окна системное сообщение «для запуска необходимо установить .NET
         Desktop Runtime». То есть проверить это можно было только на чужом
         компьютере, а именно чужие компьютеры и есть весь смысл релиза.

         Цена — размер: 220 КБ превращаются в 68 МБ. Сжатие отыгрывает
         обратно почти половину, а разовая загрузка в 68 МБ всё равно
         дешевле, чем установка рантайма руками. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF тянет пять нативных библиотек (отрисовка, DirectX, перо). Без
         этой строки они лягут рядом с exe отдельными файлами, и «один
         файл» перестанет быть одним файлом ровно там, где это важно. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Без отладочных символов: в релизе .pdb никому не нужен, а рядом
         с exe он выглядит как забытый мусор. -->
    <DebugType>none</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms тянет свои глобальные using, и половина имён начинает
         спорить с WPF: Application, Point, MouseEventArgs есть и там и там.
         Убираем их: из WinForms нам нужен ровно значок в трее, и он
         прекрасно берётся по полному имени. -->
    <Using Remove="System.Windows.Forms"/>
    <Using Remove="System.Drawing"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Сбор данных с компьютера — раньше отдельный агент, теперь часть
         приложения. -->
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- Ради этой библиотеки сбор и написан на C#: из Python пришлось бы
         держать запущенным само приложение LHM и парсить его веб-сервер. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.3" />
  </ItemGroup>

  <!-- WindowsForms нужен ровно ради значка в трее: у WPF своего нет, а
       городить его через Shell_NotifyIcon вручную — полдня работы ради
       того, что уже написано. Окна WinForms при этом не создаются. -->

</Project>
